@using Microsoft.AspNetCore.Identity
@using ShopQuanAo.Models.BEAN.Entity
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<ShopQuanAo.Models.BEAN.Entity.SaleCampaign>

@{
    ViewData["Title"] = "Quản lý Khuyến mãi (Sale)";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    
    // Đã lấy AllProducts
    var allProducts = ViewBag.AllProducts as IEnumerable<Product> ?? new List<Product>();
    
    // Các sản phẩm dùng hiển thị cho bảng ĐANG SALE (Lọc ra toàn bộ SP có SalePrice > 0)
    var productsOnSale = allProducts.Where(p => p.SalePrice > 0).ToList();
    
    // Các sản phẩm dùng để thêm mới vào Campaign (Chỉ hiện những SP CHƯA thuộc chiến dịch nào)
    var availableProductsForAdd = allProducts.Where(p => p.SaleCampaignId == null).ToList();
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="~/css/Admin/Admin_Sale.css" asp-append-version="true" rel="stylesheet" />

<style>
    .sale-card { border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); background: #fff; }
    .custom-table th { background-color: #f3f4f6 !important; color: #4b5563 !important; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; padding: 14px; border-bottom: 2px solid #e5e7eb; }
    .custom-table td { padding: 14px; vertical-align: middle; color: #1f2937; border-bottom: 1px solid #f3f4f6; }
    .product-img-wrapper { width: 50px; height: 50px; border-radius: 8px; overflow: hidden; border: 1px solid #e5e7eb; background: #f9fafb; display: flex; align-items: center; justify-content: center; }
    .product-img-wrapper img { width: 100%; height: 100%; object-fit: cover; }
    .search-box-custom { border-radius: 8px; border: 1px solid #d1d5db; padding-left: 38px; transition: all 0.2s; }
    .search-box-custom:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .btn-create-sale { background: #2563eb; color: #fff; font-weight: 600; border-radius: 8px; padding: 10px 20px; border: none; transition: background 0.2s; }
    .btn-create-sale:hover { background: #1d4ed8; color: #fff; }
    .badge-pill-custom { padding: 6px 12px; border-radius: 50px; font-weight: 500; font-size: 0.8rem; }
    .modal-content-custom { border-radius: 16px; border: none; overflow: hidden; }
    .scroll-table-container { max-height: 380px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; }
</style>

@Html.AntiForgeryToken()

<div class="admin-wrap">
    <div class="admin-body">
        
        <aside class="admin-sidebar">
            <div class="sidebar-section">
                <div class="sidebar-label">Tổng quan</div>
                <a class="sidebar-link @(currentAction == "Index" ? "active" : "")" href="@Url.Action("Index", "Admin")">
                    <span class="sidebar-icon">📊</span> Dashboard
                </a>
                <a class="sidebar-link @(currentAction == "Revenue" ? "active" : "")" href="@Url.Action("Revenue", "Admin")">
                    <span class="sidebar-icon">💰</span> Doanh thu
                </a>
                <a class="sidebar-link @(currentAction == "Orders" ? "active" : "")" href="@Url.Action("Orders", "Admin")">
                    <span class="sidebar-icon">📦</span> Đơn hàng
                </a>
            </div>

            <div class="sidebar-section">
                 <div class="sidebar-label">Quản lý</div>
                <a class="sidebar-link @(currentAction == "Users" ? "active" : "")" href="@Url.Action("Users", "Admin")">
                    <span class="sidebar-icon">👥</span> Người dùng
                </a>
                <a class="sidebar-link @(currentAction == "Products" ? "active" : "")" href="@Url.Action("Products", "Admin")">
                    <span class="sidebar-icon">👕</span> Sản phẩm
                </a>
                <a class="sidebar-link @(currentAction == "Categories" ? "active" : "")" href="@Url.Action("Categories", "Admin")">
                    <span class="sidebar-icon">📁</span> Danh mục
                </a>
                <a class="sidebar-link active" href="@Url.Action("Sales", "Admin")">
                    <span class="sidebar-icon">★</span> Khuyến mãi (Sale)
                </a>
                <a class="sidebar-link @(currentAction == "Vouchers" ? "active" : "")" href="@Url.Action("Vouchers", "Admin")">
                    <span class="sidebar-icon">🎫</span> Mã giảm giá
                </a>
                <a class="sidebar-link @(currentAction == "Contacts" ? "active" : "")" href="@Url.Action("Contacts", "Admin")">
                    <span class="sidebar-icon">📩</span> Phản hồi
                </a>
            </div>
            <div class="sidebar-section">
                <div class="sidebar-label">Hệ thống</div>
                <a class="sidebar-link" href="@Url.Action("Index", "Home")">
                    <span class="sidebar-icon">🏠</span> Về cửa hàng
                </a>
                <a class="sidebar-link" href="/Identity/Account/Manage">
                    <span class="sidebar-icon">⚙️</span> Tài khoản
                </a>
            </div>
        </aside>

        <main class="admin-content light-mode">
            
            <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                <h3 class="m-0 fw-bold text-dark" style="letter-spacing: -0.5px;">Sản phẩm đang Khuyến mãi</h3>
                <div class="d-flex gap-3 align-items-center">
                    <div class="position-relative">
                        <i class="fas fa-search text-muted position-absolute" style="top: 12px; left: 14px; z-index: 5;"></i>
                        <input type="text" id="searchSaleMain" class="form-control search-box-custom" placeholder="Tìm sản phẩm đang sale..." onkeyup="filterMainTable()" style="width: 280px;">
                    </div>
                    <button class="btn btn-create-sale shadow-sm" data-bs-toggle="modal" data-bs-target="#addSaleModal">
                        <i class="fas fa-plus me-1"></i> Thiết lập Sale
                    </button>
                </div>
            </div>

            <div class="card sale-card mb-5">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-table" id="mainSaleTable">
                        <thead>
                            <tr>
                                <th style="width: 80px;" class="text-center">Ảnh</th>
                                <th>Tên Sản Phẩm</th>
                                <th>Giá Gốc</th>
                                <th>Giá Đang Sale</th>
                                <th>Chương Trình</th>
                                <th class="text-center" style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (productsOnSale.Any())
                            {
                                foreach (var item in productsOnSale)
                                {
                                    string campName = "Sale Nhỏ Lẻ";
                                    if (item.SaleCampaignId.HasValue && Model != null)
                                    {
                                        var camp = Model.FirstOrDefault(c => c.Id == item.SaleCampaignId.Value);
                                        if (camp != null) campName = camp.CampaignName;
                                    }

                                    <tr class="main-sale-row">
                                        <td class="text-center">
                                            <div class="product-img-wrapper mx-auto">
                                                <img src="@(item.Image != null && item.Image.StartsWith("http") ? item.Image : "/" + (item.Image ?? "images/default.jpg"))" alt="Ảnh" onerror="this.src='/images/default.jpg'" />
                                            </div>
                                        </td>
                                        <td class="fw-bold text-dark product-name">@item.ProductName</td>
                                        <td><del class="text-muted small">@item.Price.ToString("N0") đ</del></td>
                                        <td class="text-danger fw-bold fs-6">@item.SalePrice.ToString("N0") đ</td>
                                        <td>
                                            @if (item.SaleCampaignId.HasValue)
                                            {
                                                <span class="badge bg-success-subtle text-success badge-pill-custom border border-success-subtle mb-1">@campName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary badge-pill-custom border border-secondary-subtle mb-1">@campName</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-link text-primary p-1 border-0" onclick="openEditProductModal(@item.Id, '@item.ProductName', @item.Price, @item.SalePrice)" title="Sửa giá Sale">
                                                <i class="fas fa-edit fs-5"></i>
                                            </button>
                                            <button class="btn btn-link text-danger p-1 border-0 ms-1" onclick="disableSale(@item.Id)" title="Hủy Sale">
                                                <i class="fas fa-trash-alt fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="noDataMain"><td colspan="6" class="text-center py-5 text-muted fs-6">Chưa có sản phẩm nào đang giảm giá.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="m-0 fw-bold text-dark" style="letter-spacing: -0.5px;">Quản lý Chương trình Sale</h3>
            </div>
            
            <div class="card sale-card mb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 custom-table">
                        <thead>
                            <tr>
                                <th>Tên Chương Trình</th>
                                <th>Thời Gian Bắt Đầu</th>
                                <th>Thời Gian Kết Thúc</th>
                                <th>Trạng Thái</th>
                                <th class="text-center" style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var camp in Model)
                                {
                                    var status = DateTime.Now >= camp.StartDate && DateTime.Now <= camp.EndDate ? "Đang chạy" : (DateTime.Now < camp.StartDate ? "Sắp diễn ra" : "Đã kết thúc");
                                    var statusClass = status == "Đang chạy" ? "bg-success" : (status == "Sắp diễn ra" ? "bg-warning text-dark" : "bg-secondary");
                                    <tr class="campaign-row">
    <td class="fw-bold text-dark campaign-name">@camp.CampaignName</td>
                                        <td>@camp.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@camp.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><span class="badge @statusClass badge-pill-custom">@status</span></td>
                                        <td class="text-center">
                                            <button class="btn btn-link text-primary p-1 border-0" onclick="openEditCampaignModal(@camp.Id)" title="Sửa thông tin">
                                                <i class="fas fa-edit fs-5"></i>
                                            </button>
                                            <button class="btn btn-link text-danger p-1 border-0 ms-1" onclick="deleteCampaign(@camp.Id)" title="Xóa toàn bộ">
                                                <i class="fas fa-trash-alt fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có chương trình khuyến mãi nào được tạo.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>

<div class="modal fade" id="addSaleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-content-custom shadow-lg">
            <div class="modal-header bg-dark text-white p-4">
                <h5 class="modal-title fw-bold m-0"><i class="fas fa-tags text-warning me-2"></i> Thiết Lập Chương Trình Khuyến Mãi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card p-3 border-0 shadow-sm mb-3" style="border-radius: 10px;">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-sliders-h me-1 text-primary"></i> 1. Thông tin Campaign</h6>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Tên chiến dịch</label>
                                <input type="text" id="campName" class="form-control" placeholder="Tùy chọn (để trống nếu tạo sale lẻ)" onblur="validateCampaignName()">
                                <small id="campNameError" class="text-danger mt-1 fw-bold" style="display:none;">
                                    <i class="fas fa-exclamation-circle"></i> Tên chiến dịch này đã tồn tại!
                                </small>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1">Bắt đầu</label>
                                <input type="datetime-local" id="startDate" class="form-control">
                            </div>
                            <div>
                                <label class="form-label small text-muted mb-1">Kết thúc</label>
                                <input type="datetime-local" id="endDate" class="form-control">
                            </div>
                        </div>
                        <div class="card p-3 border-0 shadow-sm border-start border-warning border-4" style="border-radius: 10px;">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-magic me-1 text-warning"></i> 2. Công cụ tính giá nhanh</h6>
                            <div class="mb-2">
                                <select id="discountType" class="form-select">
                                    <option value="percent">Giảm theo tỷ lệ %</option>
                                    <option value="amount">Giảm trừ số tiền (đ)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <input type="number" id="discountValue" class="form-control" placeholder="Mức giảm (VD: 10)">
                            </div>
                            <button class="btn btn-warning w-100 fw-bold text-dark" onclick="autoCalculate()">
                                Tính giá tự động <i class="fas fa-bolt ms-1"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="card p-3 border-0 shadow-sm" style="border-radius: 10px; height: 100%;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark m-0"><i class="fas fa-th-list me-1 text-primary"></i> 3. Chọn sản phẩm</h6>
                                <div class="position-relative">
                                    <i class="fas fa-search text-muted position-absolute" style="top: 9px; left: 12px; font-size: 0.85rem;"></i>
                                    <input type="text" id="searchModal" class="form-control form-control-sm ps-4" placeholder="Tìm..." onkeyup="filterModalTable('searchModal', 'modal-product-row', 'modal-product-name')" style="width: 220px;">
                                </div>
                            </div>
                            <div class="scroll-table-container">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-dark" style="position: sticky; top: 0; z-index: 10;">
                                        <tr>
                                            <th class="text-center" style="width: 50px;"><input type="checkbox" class="form-check-input" onclick="toggleAll(this, 'modal-product-row', 'chk-item')"></th>
                                            <th>Sản phẩm</th>
                                            <th>Giá gốc</th>
                                            <th style="width: 150px;">Giá Sale mới</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (availableProductsForAdd != null)
                                        {
                                            foreach (var p in availableProductsForAdd)
                                            {
                                                <tr class="modal-product-row">
                                                    <td class="text-center"><input type="checkbox" class="form-check-input chk-item" value="@p.Id"></td>
                                                    <td class="modal-product-name fw-bold text-secondary">@p.ProductName</td>
                                                    <td class="text-danger fw-bold orig-price" data-price="@p.Price">@p.Price.ToString("N0")</td>
                                                    <td><input type="number" class="form-control form-control-sm item-saleprice" data-id="@p.Id" placeholder="Nhập giá..."></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-3 border-top-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-primary px-5 fw-bold" onclick="saveData()">Kích hoạt Khuyến mãi</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editCampaignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-content-custom shadow-lg">
            <div class="modal-header bg-dark text-white p-4">
                <h5 class="modal-title fw-bold m-0"><i class="fas fa-cog text-warning me-2"></i> Chỉnh Sửa Chương Trình</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                <input type="hidden" id="editCampId" />
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card p-3 border-0 shadow-sm mb-3" style="border-radius: 10px;">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-sliders-h me-1 text-primary"></i> 1. Thông tin Campaign</h6>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Tên chiến dịch</label>
                                <input type="text" id="editCampName" class="form-control" onblur="validateEditCampaignName()">
                                <small id="editCampNameError" class="text-danger mt-1 fw-bold" style="display:none;">
                                    <i class="fas fa-exclamation-circle"></i> Tên chiến dịch này đã tồn tại!
                                </small>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1">Bắt đầu</label>
                                <input type="datetime-local" id="editCampStart" class="form-control">
                            </div>
                            <div>
                                <label class="form-label small text-muted mb-1">Kết thúc</label>
                                <input type="datetime-local" id="editCampEnd" class="form-control">
                            </div>
                        </div>
                        <div class="card p-3 border-0 shadow-sm border-start border-warning border-4" style="border-radius: 10px;">
                            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-magic me-1 text-warning"></i> 2. Công cụ tính giá nhanh</h6>
                            <div class="mb-2">
                                <select id="editDiscountType" class="form-select">
                                    <option value="percent">Giảm theo tỷ lệ %</option>
                                    <option value="amount">Giảm trừ số tiền (đ)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <input type="number" id="editDiscountValue" class="form-control" placeholder="Mức giảm (VD: 10)">
                            </div>
                            <button class="btn btn-warning w-100 fw-bold text-dark" onclick="autoCalculateEdit()">
                                Tính giá tự động <i class="fas fa-bolt ms-1"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="card p-3 border-0 shadow-sm" style="border-radius: 10px; height: 100%;">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark m-0"><i class="fas fa-th-list me-1 text-primary"></i> 3. Chọn sản phẩm</h6>
                                <div class="position-relative">
                                    <i class="fas fa-search text-muted position-absolute" style="top: 9px; left: 12px; font-size: 0.85rem;"></i>
                                    <input type="text" id="searchEditModal" class="form-control form-control-sm ps-4" placeholder="Tìm..." onkeyup="filterModalTable('searchEditModal', 'modal-product-row-edit', 'modal-product-name-edit')" style="width: 220px;">
                                </div>
                            </div>
                            <div class="scroll-table-container">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-dark" style="position: sticky; top: 0; z-index: 10;">
                                        <tr>
                                            <th class="text-center" style="width: 50px;"><input type="checkbox" class="form-check-input" onclick="toggleAll(this, 'modal-product-row-edit', 'chk-item-edit')"></th>
                                            <th>Sản phẩm</th>
                                            <th>Giá gốc</th>
                                            <th style="width: 150px;">Giá Sale mới</th>
                                        </tr>
                                    </thead>
                                    <tbody id="editModalTableBody">
                                        </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-3 border-top-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" onclick="submitEditCampaign()">Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editSingleSaleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom shadow-lg">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-bold m-0"><i class="fas fa-edit me-2"></i> Chỉnh Sửa Giá Sản Phẩm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                <input type="hidden" id="editProdId" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Tên sản phẩm</label>
                    <input type="text" id="editProdName" class="form-control bg-light" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Giá Gốc (đ)</label>
                    <input type="text" id="editProdOrigPrice" class="form-control bg-light" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-danger">Giá Sale Mới (đ)</label>
                    <input type="number" id="editProdSalePrice" class="form-control border-danger" placeholder="Nhập mức giá sale mới..." />
                </div>
            </div>
            <div class="modal-footer bg-light p-3 border-top-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" onclick="submitEditProduct()">Lưu Thay Đổi</button>
            </div>
        </div>
    </div>
</div>

<script>
    // --- Các biến cờ validation ---
    let isCampaignNameValid = true;
    let isEditCampaignNameValid = true;
    let originalEditCampName = ""; 

    // --- Các hàm UI Filter dùng chung ---
    function filterMainTable() {
    const input = document.getElementById("searchSaleMain").value.toLowerCase();

    // Filter bảng sản phẩm đang sale
    let hasProduct = false;
    document.querySelectorAll(".main-sale-row").forEach(row => {
        const name = row.querySelector(".product-name").textContent.toLowerCase();
        const show = name.includes(input);
        row.style.display = show ? "" : "none";
        if (show) hasProduct = true;
    });
    const noDataRow = document.getElementById("noDataMain");
    if (noDataRow) noDataRow.style.display = hasProduct || !input ? "none" : "";

    // Filter bảng chiến dịch sale
    document.querySelectorAll(".campaign-row").forEach(row => {
        const name = row.querySelector(".campaign-name").textContent.toLowerCase();
        row.style.display = name.includes(input) ? "" : "none";
    });
}
    
    function filterModalTable(inputId, rowClass, nameClass) {
        let input = document.getElementById(inputId).value.toLowerCase();
        let rows = document.querySelectorAll("." + rowClass);
        rows.forEach(row => {
            let name = row.querySelector("." + nameClass).textContent.toLowerCase();
            row.style.display = name.includes(input) ? "" : "none";
        });
    }
    
    function toggleAll(source, rowClass, checkClass) {
        document.querySelectorAll('.' + rowClass).forEach(row => {
            if (row.style.display !== "none") { let chk = row.querySelector('.' + checkClass); if(chk) chk.checked = source.checked; }
        });
    }
    
    // --- CÁC HÀM VALIDATE THEO THỜI GIAN THỰC ---
    async function validateCampaignName() {
        const nameInput = document.getElementById('campName');
        const name = nameInput.value.trim();
        const errorMsg = document.getElementById('campNameError');

        if (!name) {
            isCampaignNameValid = true;
            errorMsg.style.display = 'none';
            nameInput.classList.remove('is-invalid', 'is-valid');
            return;
        }

        try {
            const res = await fetch(`/Admin/CheckCampaignName?name=${encodeURIComponent(name)}`);
            const data = await res.json();

            if (data.isExist) {
                isCampaignNameValid = false;
                errorMsg.style.display = 'block';
                nameInput.classList.add('is-invalid');
                nameInput.classList.remove('is-valid');
            } else {
                isCampaignNameValid = true;
                errorMsg.style.display = 'none';
                nameInput.classList.remove('is-invalid');
                nameInput.classList.add('is-valid');
            }
        } catch (err) {
            console.error("Lỗi khi kiểm tra tên chiến dịch:", err);
        }
    }

    async function validateEditCampaignName() {
        const nameInput = document.getElementById('editCampName');
        const name = nameInput.value.trim();
        const errorMsg = document.getElementById('editCampNameError');

        if (!name || name.toLowerCase() === originalEditCampName.toLowerCase()) {
            isEditCampaignNameValid = true;
            errorMsg.style.display = 'none';
            nameInput.classList.remove('is-invalid', 'is-valid');
            return;
        }

        try {
            const res = await fetch(`/Admin/CheckCampaignName?name=${encodeURIComponent(name)}`);
            const data = await res.json();

            if (data.isExist) {
                isEditCampaignNameValid = false;
                errorMsg.style.display = 'block';
                nameInput.classList.add('is-invalid');
                nameInput.classList.remove('is-valid');
            } else {
                isEditCampaignNameValid = true;
                errorMsg.style.display = 'none';
                nameInput.classList.remove('is-invalid');
                nameInput.classList.add('is-valid');
            }
        } catch (err) {
            console.error("Lỗi khi kiểm tra tên chiến dịch:", err);
        }
    }

    // --- Tính năng của MODAL TẠO MỚI ---
    function autoCalculate() {
        const type = document.getElementById('discountType').value;
        const val = parseFloat(document.getElementById('discountValue').value);
        if (!val || val <= 0) return Swal.fire('Lỗi', 'Nhập mức giảm hợp lệ!', 'warning');
        const checked = document.querySelectorAll('.chk-item:checked');
        if (checked.length === 0) return Swal.fire('Lỗi', 'Vui lòng Tick chọn sản phẩm trước!', 'warning');
        let hasError = false, errorMsg = "";

        checked.forEach(chk => {
            if(hasError) return; 
            const tr = chk.closest('tr');
            const orig = parseFloat(tr.querySelector('.orig-price').getAttribute('data-price'));
            let input = tr.querySelector('.item-saleprice');
            let newPrice = type === 'percent' ? orig * (1 - val/100) : orig - val;

            if (newPrice <= 0) {
                hasError = true;
                errorMsg = `Mức giảm khiến giá sản phẩm <= 0 đ. Vui lòng kiểm tra lại.`;
                input.value = "";
            } else {
                input.value = Math.floor(newPrice); 
            }
        });
        if (hasError) Swal.fire('Lỗi', errorMsg, 'error');
    }

    async function saveData(force = false) {
        if (!isCampaignNameValid) {
            document.getElementById('campName').focus();
            return Swal.fire('Lỗi', 'Tên chiến dịch đã tồn tại. Vui lòng chọn tên khác trước khi tiếp tục!', 'error');
        }

        const name = document.getElementById('campName').value.trim();
        const start = document.getElementById('startDate').value;
        const end = document.getElementById('endDate').value;
        let pIds = [], pPrices = [], hasError = false;

        document.querySelectorAll('.chk-item:checked').forEach(chk => {
            const tr = chk.closest('tr');
            const priceInput = tr.querySelector('.item-saleprice').value;
            const orig = parseFloat(tr.querySelector('.orig-price').getAttribute('data-price'));
            if (!priceInput || priceInput <= 0 || priceInput >= orig) hasError = true;
            else { pIds.push(parseInt(chk.value)); pPrices.push(parseInt(priceInput)); }
        });
        if (hasError) return Swal.fire('Lỗi', 'Có sản phẩm giá Sale trống, <= 0, hoặc >= giá gốc!', 'error');
        if (pIds.length === 0) return Swal.fire('Lỗi', 'Vui lòng chọn ít nhất 1 sản phẩm!', 'warning');
        
        const payload = { CampaignName: name, StartDate: start || new Date().toISOString(), EndDate: end || new Date(new Date().getTime() + 7*24*60*60*1000).toISOString(), ProductIds: pIds, SalePrices: pPrices };
        
        // --- Lấy token để gọi POST ---
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        
        Swal.showLoading();
        try {
            if (!force) {
                const valRes = await fetch('/Admin/ValidateCampaign', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, 
                    body: JSON.stringify(payload) 
                });
                const valData = await valRes.json();
                if (!valData.success) return Swal.fire('Lỗi', valData.message, 'error');
                if (valData.warnings && valData.warnings.length > 0) {
                    return Swal.fire({ title: 'Cảnh báo', html: valData.warnings.join('<br/>') + '<br/><b>Ghi đè và tiếp tục?</b>', icon: 'warning', showCancelButton: true, confirmButtonText: 'Tiếp tục' })
                               .then((r) => { if (r.isConfirmed) saveData(true); });
                }
            }
            const res = await fetch('/Admin/CreateCampaign', { 
                method: 'POST', 
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, 
                body: JSON.stringify(payload) 
            });
            const data = await res.json();
            if (data.success) Swal.fire('Thành công!', 'Đã lưu.', 'success').then(() => location.reload());
            else Swal.fire('Thất bại', data.message, 'error');
        } catch (err) { Swal.fire('Lỗi mạng!', 'Vui lòng thử lại sau.', 'error'); }
    }

    // --- Tính năng của MODAL CHỈNH SỬA CHIẾN DỊCH (MỚI) ---
    async function openEditCampaignModal(id) {
        Swal.showLoading();
        try {
            const res = await fetch(`/Admin/GetCampaignForEdit?id=${id}`);
            const data = await res.json();
            
            if (!data.success) {
                Swal.fire('Lỗi', data.message, 'error');
                return;
            }

            originalEditCampName = data.name;
            document.getElementById('editCampNameError').style.display = 'none';
            document.getElementById('editCampName').classList.remove('is-invalid', 'is-valid');
            isEditCampaignNameValid = true;

            document.getElementById('editCampId').value = data.id;
            document.getElementById('editCampName').value = data.name;
            document.getElementById('editCampStart').value = data.startDate;
            document.getElementById('editCampEnd').value = data.endDate;

            const tbody = document.getElementById('editModalTableBody');
            let html = '';
            data.products.forEach(p => {
                const isChecked = p.inCampaign ? 'checked' : '';
                const salePriceVal = p.salePrice > 0 ? p.salePrice : '';
                html += `
                    <tr class="modal-product-row-edit">
                        <td class="text-center"><input type="checkbox" class="form-check-input chk-item-edit" value="${p.id}" ${isChecked}></td>
                        <td class="modal-product-name-edit fw-bold text-secondary">${p.productName}</td>
                        <td class="text-danger fw-bold orig-price-edit" data-price="${p.price}">${p.price.toLocaleString('vi-VN')}</td>
                        <td><input type="number" class="form-control form-control-sm item-saleprice-edit" data-id="${p.id}" value="${salePriceVal}" placeholder="Nhập giá..."></td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
            
            Swal.close();
            new bootstrap.Modal(document.getElementById('editCampaignModal')).show();
        } catch (err) {
            Swal.fire('Lỗi', 'Không thể kết nối lấy dữ liệu', 'error');
        }
    }

    function autoCalculateEdit() {
        const type = document.getElementById('editDiscountType').value;
        const val = parseFloat(document.getElementById('editDiscountValue').value);
        if (!val || val <= 0) return Swal.fire('Lỗi', 'Nhập mức giảm hợp lệ!', 'warning');
        const checked = document.querySelectorAll('.chk-item-edit:checked');
        if (checked.length === 0) return Swal.fire('Lỗi', 'Vui lòng Tick chọn sản phẩm trước!', 'warning');
        let hasError = false;

        checked.forEach(chk => {
            if(hasError) return; 
            const tr = chk.closest('tr');
            const orig = parseFloat(tr.querySelector('.orig-price-edit').getAttribute('data-price'));
            let input = tr.querySelector('.item-saleprice-edit');
            let newPrice = type === 'percent' ? orig * (1 - val/100) : orig - val;

            if (newPrice <= 0) {
                hasError = true;
                input.value = "";
            } else {
                input.value = Math.floor(newPrice); 
            }
        });
        if (hasError) Swal.fire('Lỗi', 'Mức giảm quá lớn khiến vài sản phẩm có giá <= 0đ.', 'error');
    }

    async function submitEditCampaign() {
        if (!isEditCampaignNameValid) {
            document.getElementById('editCampName').focus();
            return Swal.fire('Lỗi', 'Tên chiến dịch đã tồn tại. Vui lòng chọn tên khác!', 'error');
        }

        const id = document.getElementById('editCampId').value;
        const name = document.getElementById('editCampName').value.trim();
        const start = document.getElementById('editCampStart').value;
        const end = document.getElementById('editCampEnd').value;
        if (!name || !start || !end) return Swal.fire('Lỗi', 'Vui lòng điền đủ thông tin!', 'warning');

        let pIds = [], pPrices = [], hasError = false;
        document.querySelectorAll('.chk-item-edit:checked').forEach(chk => {
            const tr = chk.closest('tr');
            const priceInput = tr.querySelector('.item-saleprice-edit').value;
            const orig = parseFloat(tr.querySelector('.orig-price-edit').getAttribute('data-price'));
            if (!priceInput || priceInput <= 0 || priceInput >= orig) hasError = true;
            else { pIds.push(parseInt(chk.value)); pPrices.push(parseInt(priceInput)); }
        });

        if (hasError) return Swal.fire('Lỗi', 'Giá Sale phải > 0 và < Giá gốc!', 'error');
        if (pIds.length === 0) return Swal.fire('Lỗi', 'Vui lòng chọn ít nhất 1 sản phẩm cho chiến dịch!', 'warning');

        // --- Lấy token để gọi POST ---
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        Swal.showLoading();
        try {
            const res = await fetch('/Admin/UpdateCampaign', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token 
                },
                body: JSON.stringify({ Id: parseInt(id), CampaignName: name, StartDate: start, EndDate: end, ProductIds: pIds, SalePrices: pPrices })
            });
            if (!res.ok) throw new Error(`HTTP error: ${res.status}`);
            
            const data = await res.json();
            if (data.success) {
                Swal.fire('Thành công', 'Đã cập nhật Chương trình.', 'success').then(() => location.reload());
            } else {
                Swal.fire('Lỗi', data.message, 'error');
            }
        } catch (err) { Swal.fire('Lỗi', 'Lỗi kết nối máy chủ!', 'error'); }
    }

    // --- CÁC HÀM XÓA & TẮT SALE KHÁC ---
    function disableSale(id) {
        Swal.fire({ title: 'Hủy Sale SP này?', text: "SP sẽ quay về giá gốc.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#2563eb', confirmButtonText: 'Đồng ý' })
            .then(async (r) => { if (r.isConfirmed) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Admin/DisableSale', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, 
                    body: JSON.stringify({ productId: id }) 
                });
                if((await res.json()).success) location.reload();
            }});
    }

    function deleteCampaign(id) {
        Swal.fire({ title: 'Xóa toàn bộ?', text: "Các SP sẽ mất giá sale. Bạn chắc chứ?", icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc2626', confirmButtonText: 'Xóa' })
            .then(async (r) => { if (r.isConfirmed) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Admin/DeleteCampaign', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, 
                    body: JSON.stringify({ id: id.toString() }) 
                });
                if((await res.json()).success) location.reload();
            }});
    }

    function openEditProductModal(id, name, origPrice, salePrice) {
        document.getElementById('editProdId').value = id;
        document.getElementById('editProdName').value = name;
        document.getElementById('editProdOrigPrice').value = new Intl.NumberFormat('vi-VN').format(origPrice);
        document.getElementById('editProdSalePrice').value = salePrice;
        new bootstrap.Modal(document.getElementById('editSingleSaleModal')).show();
    }

    async function submitEditProduct() {
        const id = document.getElementById('editProdId').value;
        const salePrice = parseInt(document.getElementById('editProdSalePrice').value);
        const origPrice = parseInt(document.getElementById('editProdOrigPrice').value.replace(/\./g, '').replace(/,/g, ''));
        if (!salePrice || salePrice <= 0 || salePrice >= origPrice) return Swal.fire('Lỗi', 'Giá không hợp lệ!', 'error');
        
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const res = await fetch('/Admin/UpdateSalePrice', { 
            method: 'POST', 
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, 
            body: JSON.stringify({ productId: parseInt(id), salePrice: salePrice }) 
        });
        if((await res.json()).success) location.reload();
    }
</script>