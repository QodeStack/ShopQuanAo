@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="register-page-wrapper">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 85vh; padding: 40px 0;">
            <div class="col-md-6 col-lg-5">
                <div class="register-box shadow-sm border p-4 p-md-5 bg-white">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-uppercase" style="letter-spacing: 3px;">Đặt Lại Mật Khẩu</h2>
                        <p class="text-muted small">Nhập mật khẩu mới của bạn</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small mb-3" role="alert"></div>
                        <input asp-for="Input.Code" type="hidden" />

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-0 border-dark" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-uppercase small fw-bold">Địa chỉ Email *</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-0 border-dark" autocomplete="new-password" aria-required="true" placeholder="Mật khẩu mới" />
                            <label asp-for="Input.Password" class="text-uppercase small fw-bold">Mật Khẩu Mới *</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" class="form-control rounded-0 border-dark" autocomplete="new-password" aria-required="true" placeholder="Xác nhận mật khẩu" />
                            <label asp-for="Input.ConfirmPassword" class="text-uppercase small fw-bold">Xác Nhận Mật Khẩu *</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 rounded-0 py-3 fw-bold text-uppercase mb-3">
                            Đặt Lại Mật Khẩu
                        </button>
                    </form>

                    <div class="text-center">
                        <small class="text-muted">Quay lại <a asp-page="./Login" class="text-decoration-none fw-bold">Đăng nhập</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
