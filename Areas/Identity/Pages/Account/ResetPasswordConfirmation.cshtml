@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="register-page-wrapper">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 85vh; padding: 40px 0;">
            <div class="col-md-6 col-lg-5">
                <div class="register-box shadow-sm border p-4 p-md-5 bg-white text-center">
                    <div class="mb-4">
                        <i class="bi bi-check-circle text-success mb-3" style="font-size: 3rem;"></i>
                        <h2 class="fw-bold text-dark">Mật Khẩu Đã Được Đặt Lại</h2>
                    </div>

                    <p class="text-muted mb-4">
                        Mật khẩu của bạn đã được đặt lại thành công.
                        <br/><br/>
                        Vui lòng <strong>đăng nhập</strong> với mật khẩu mới.
                    </p>

                    <a asp-page="./Login" class="btn btn-dark w-100 rounded-0 py-3 fw-bold text-uppercase">
                        Đăng Nhập Ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
