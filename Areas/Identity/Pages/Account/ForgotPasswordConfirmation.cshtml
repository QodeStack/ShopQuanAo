@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
}

<div class="register-page-wrapper">
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 85vh; padding: 40px 0;">
            <div class="col-md-6 col-lg-5">
                <div class="register-box shadow-sm border p-4 p-md-5 bg-white text-center">
                    <div class="mb-4">
                        <i class="bi bi-check-circle text-success mb-3" style="font-size: 3rem;"></i>
                        <h2 class="fw-bold text-dark">Email Đã Được Gửi</h2>
                    </div>

                    <p class="text-muted mb-4">
                        Vui lòng kiểm tra email của bạn để nhận link đặt lại mật khẩu.
                        <br/><br/>
                        <strong>Lưu ý:</strong> Link sẽ hết hạn sau 24 giờ.
                    </p>

                    <a href="/" class="btn btn-dark w-100 rounded-0 py-3 fw-bold text-uppercase">
                        Về Trang Chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
